{
  "name": "computer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/hub",
    "packages/shared",
    "packages/proto",
    "apps/*"
  ],
  "scripts": {
    "up": "node scripts/computer.mjs up",
    "qr": "node scripts/computer.mjs qr",
    "bot": "node scripts/computer.mjs bot",
    "proto:gen": "buf generate",
    "proto:check": "node scripts/proto-check.mjs",
    "lint": "node scripts/lint-layers.mjs",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=packages/proto && npm run typecheck --workspace=apps/hub",
    "test": "npm test --workspace=apps/hub",
    "hub": "npm run start --workspace=apps/hub",
    "eve": "npm --prefix apps/eve run dev",
    "web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.57.2",
    "@bufbuild/protoc-gen-es": "^2.10.0"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
