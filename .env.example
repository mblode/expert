# Hub binds loopback only. Publish with Tailscale Serve, not 0.0.0.0.
COMPUTER_BIND=127.0.0.1
COMPUTER_PORT=8787
COMPUTER_SETUP_CODE=change-me
COMPUTER_AGENT_TOKEN=change-me-too
COMPUTER_PUBLIC_URL=https://computer.tailnet.ts.net
COMPUTER_DESK=docker
COMPUTER_DESK_CONTAINER=computer-desk
COMPUTER_VNC_HOST=127.0.0.1
COMPUTER_VNC_PORT=5900

# BYO. Leave empty to run the hub without an agent loop.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
