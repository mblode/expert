# You do not need to write this file, `npm run up` generates .env with a
# random setup code and sane defaults. It exists to document the knobs.

# Local / Hetzner: loopback only. Publish with Tailscale Serve, not 0.0.0.0.
# Fly guest sets COMPUTER_BIND=0.0.0.0 and COMPUTER_CLOUD=fly (see fly.toml).
COMPUTER_BIND=127.0.0.1
COMPUTER_PORT=8787
# Pairing secret. Generated by `npm run up`; shown as a QR for the iPhone.
# On Fly this must be a secret: `fly secrets set COMPUTER_SETUP_CODE=…`.
COMPUTER_SETUP_CODE=
# The CLI's own seat token. Paired once by `npm run bot`, then reused.
# COMPUTER_SEAT_TOKEN=
# What the phone connects to (Tailscale Serve URL; auto-detected by `up`).
COMPUTER_PUBLIC_URL=https://computer.tailnet.ts.net
# docker (compose host → desk container) | local (hub+desk in one guest) | fake
COMPUTER_DESK=docker
COMPUTER_DESK_CONTAINER=computer-desk
# Set on the Fly Machine so the hub may bind 0.0.0.0 behind the HTTPS proxy.
# COMPUTER_CLOUD=fly
# Roster file. Bots are provisioned at runtime (CreateBot / `npm run bot`);
# this holds their tokens, keep it out of git. Fly guest: /workspace/.computer/bots.json
# Paired seats (seats.json), the hub→Eve secret and policy.json live beside it.
COMPUTER_DATA=data/bots.json
COMPUTER_VNC_HOST=127.0.0.1
# Base port: window N (X display :N) serves x11vnc RFB on COMPUTER_VNC_PORT + N.
COMPUTER_VNC_PORT=5900
# Short-lived pixel tokens (seconds) stamped into vnc_url.
# COMPUTER_VNC_TTL_SEC=900
# COMPUTER_VNC_TOKEN_DIR=data/vnc-tokens

# Optional override: send the primary bot's /eve/v1 traffic here.
# Unset on the guest, the hub maps each roster bot to 127.0.0.1:2000+(display-1).
# COMPUTER_EVE_URL=http://127.0.0.1:2000
# Shared hub→Eve secret (minted onto the data dir if unset).
# COMPUTER_EVE_SECRET=
# Per-bot eve.dev projects (default apps/eve/bots). A populated
# /workspace/eve/bots overlay (standalone Eve app or bots/<id>) wins.
# COMPUTER_EVE_BOTS=apps/eve/bots
# Model access for `eve start` (Vercel AI Gateway; a Fly secret in prod).
# AI_GATEWAY_API_KEY=

# Cloud computer host (Fly Machines). Used by `npm run machine -- wake|sleep`.
# Tokens stay in the environment, never commit them.
# FLY_API_TOKEN=
# FLY_APP_NAME=mblode-computer
# FLY_MACHINE_ID=

# --- Vercel apps/web (product front door): see apps/web/.env.example ---
