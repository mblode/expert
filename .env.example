# Hub binds loopback only. Publish with Tailscale Serve, not 0.0.0.0.
COMPUTER_BIND=127.0.0.1
COMPUTER_PORT=8787
COMPUTER_SETUP_CODE=change-me
COMPUTER_AGENT_TOKEN=change-me-too
COMPUTER_PUBLIC_URL=https://computer.tailnet.ts.net
COMPUTER_DESK=docker
COMPUTER_DESK_CONTAINER=computer-desk
COMPUTER_VNC_HOST=127.0.0.1
# Base port: window N (X display :N) serves RFB on COMPUTER_VNC_PORT + N.
# Primary :1 is 5901. (Before multi-screen this was the exact port.)
COMPUTER_VNC_PORT=5900

# Optional roster: one Bot per screen on the shared box. Absent = one bot
# "main" on :1 using COMPUTER_AGENT_TOKEN. Displays are 1..8; each Bot's
# token is its identity. Bots are not security boundaries.
# COMPUTER_BOTS=[{"id":"main","display":1,"token":"change-me-too"},{"id":"night","display":2,"token":"another-token"}]

# Input backend override: uinput | xtest. Default: uinput on :1, xtest on :2+.
# COMPUTER_INPUT_BACKEND=

# BYO. Leave empty to run the hub without an agent loop.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
