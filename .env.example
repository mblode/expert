# You do not need to write this file — `npm run up` generates .env with a
# random setup code and sane defaults. It exists to document the knobs.

# Hub binds loopback only. Publish with Tailscale Serve, not 0.0.0.0.
COMPUTER_BIND=127.0.0.1
COMPUTER_PORT=8787
# Pairing secret. Generated by `npm run up`; shown as a QR for the iPhone.
# Local-dev fallback only — product sign-in is email OTP.
COMPUTER_SETUP_CODE=
# What clients connect to (public HTTPS URL, or Tailscale Serve when local).
COMPUTER_PUBLIC_URL=https://computer.example.com
# docker (real desk) | fake (development without Docker)
COMPUTER_DESK=docker
COMPUTER_DESK_CONTAINER=computer-desk
# Roster file. Bots are provisioned at runtime (CreateBot / `npm run bot`);
# this holds their tokens — keep it out of git.
COMPUTER_DATA=data/bots.json
COMPUTER_VNC_HOST=127.0.0.1
# Base port: window N (X display :N) serves RFB on COMPUTER_VNC_PORT + N.
COMPUTER_VNC_PORT=5900

# Where the Eve agent listens; the hub proxies /eve/v1/* to it, seat-gated,
# so the phone and the web client only ever talk to the hub.
COMPUTER_EVE_URL=http://127.0.0.1:2000

# --- Product identity: Supabase Auth (dedicated "Computer" project) ---
# Clients perform email OTP (`signInWithOtp`). The hub never sends mail.
# Leave these empty to keep `npm run up` on the setup-code / Pair path.
SUPABASE_URL=
# Publishable (anon) key — safe for web, iOS, and desktop clients.
SUPABASE_ANON_KEY=
# Hub only. HS256 secret used to verify access tokens locally.
SUPABASE_JWT_SECRET=
# Hub only. Alternative to the JWT secret: Auth `getUser` via the service role.
SUPABASE_SERVICE_ROLE_KEY=

# Web / Tauri (inlined at `next build`). Same Computer project as above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public hub the web/desktop clients call. Empty = same origin (hub-served panel)
# or http://127.0.0.1:8787 in a Tauri / file origin.
NEXT_PUBLIC_HUB_URL=

# iOS Info.plist (`INFOPLIST_KEY_*`). Same values; Xcode reads them at build.
COMPUTER_HUB_URL=

# BYO. Leave empty to run the hub without an agent loop.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
