# You do not need to write this file — `npm run up` generates .env with a
# random setup code and sane defaults. It exists to document the knobs.

# Local / Hetzner: loopback only. Publish with Tailscale Serve, not 0.0.0.0.
# Fly guest sets COMPUTER_BIND=0.0.0.0 and COMPUTER_CLOUD=fly (see fly.toml).
COMPUTER_BIND=127.0.0.1
COMPUTER_PORT=8787
# Pairing secret. Generated by `npm run up`; shown as a QR for the iPhone.
COMPUTER_SETUP_CODE=
# What the phone connects to (Tailscale Serve URL; auto-detected by `up`).
COMPUTER_PUBLIC_URL=https://computer.tailnet.ts.net
# docker (compose host → desk container) | local (hub+desk in one guest) | fake
COMPUTER_DESK=docker
COMPUTER_DESK_CONTAINER=computer-desk
# Set on the Fly Machine so the hub may bind 0.0.0.0 behind the HTTPS proxy.
# COMPUTER_CLOUD=fly
# Roster file. Bots are provisioned at runtime (CreateBot / `npm run bot`);
# this holds their tokens — keep it out of git.
COMPUTER_DATA=data/bots.json
COMPUTER_VNC_HOST=127.0.0.1
# Base port: window N (X display :N) serves RFB on COMPUTER_VNC_PORT + N.
COMPUTER_VNC_PORT=5900

# Where the Eve agent listens; the hub proxies /eve/v1/* to it, seat-gated,
# so the phone and the web client only ever talk to the hub.
COMPUTER_EVE_URL=http://127.0.0.1:2000

# Cloud computer host (Fly Machines). Used by `npm run machine -- wake|sleep`.
# Tokens stay in the environment — never commit them.
# FLY_API_TOKEN=
# FLY_APP_NAME=computer
# FLY_MACHINE_ID=

# BYO. Leave empty to run the hub without an agent loop.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
