# You do not need to write this file — `npm run up` generates .env with a
# random setup code and sane defaults. It exists to document the knobs.

# Hub binds loopback only. Publish with Tailscale Serve, not 0.0.0.0.
COMPUTER_BIND=127.0.0.1
COMPUTER_PORT=8787
# Pairing secret. Generated by `npm run up`; shown as a QR for the iPhone.
COMPUTER_SETUP_CODE=
# What the phone connects to (Tailscale Serve URL; auto-detected by `up`).
COMPUTER_PUBLIC_URL=https://computer.tailnet.ts.net
# docker (real desk) | fake (development without Docker)
COMPUTER_DESK=docker
COMPUTER_DESK_CONTAINER=computer-desk
# Roster file. Bots are provisioned at runtime (CreateBot / `npm run bot`);
# this holds their tokens — keep it out of git.
COMPUTER_DATA=data/bots.json
COMPUTER_VNC_HOST=127.0.0.1
# Base port: window N (X display :N) serves RFB on COMPUTER_VNC_PORT + N.
COMPUTER_VNC_PORT=5900
# Input backend override: uinput | xtest. Default: uinput on :1, xtest on :2+.
# COMPUTER_INPUT_BACKEND=

# BYO. Leave empty to run the hub without an agent loop.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
