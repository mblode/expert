{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["tsx", "tsc"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["@bufbuild/protoc-gen-es"]
    },
    "apps/hub": {
      "entry": [
        "src/host/eves.ts",
        "src/host/init.ts",
        "src/host/machine-cli.ts",
        "test/**/*.test.ts"
      ],
      "ignoreDependencies": ["@novnc/novnc"]
    },
    "apps/web": {
      "entry": ["lib/**/*.test.ts"],
      "ignoreDependencies": ["postcss"]
    },
    "apps/eve": {},
    "apps/eve/bots/main": {
      "entry": ["agent/**/*.ts"]
    }
  },
  "ignoreIssues": {
    "apps/web/components/ui/**": ["exports", "types", "nsExports", "nsTypes"]
  }
}
