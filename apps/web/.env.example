# Better Auth, https://better-auth.com
BETTER_AUTH_SECRET=              # generate with: openssl rand -base64 32 (required in production)
BETTER_AUTH_URL=http://localhost:3000
# Production: https://hello.expert

# Who may sign in. Every signed-in user becomes an owner of the one computer
# this deployment fronts, so leave this unset only for a private deployment.
# Comma-separated, case-insensitive.
AUTH_ALLOWED_EMAILS=

# Turso (libSQL), https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Email delivery for one-time codes. Required in production; in dev the code
# logs to the server console when unset.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Expert <hello@send.blode.co>

# Hub the signed-in server Pairs with. COMPUTER_SETUP_CODE is never NEXT_PUBLIC.
# On Vercel this is the Fly computer. In `next dev`, HUB_URL is rewritten onto
# this origin so the browser needs no CORS.
COMPUTER_SETUP_CODE=
NEXT_PUBLIC_HUB_URL=https://mblode-computer.fly.dev
COMPUTER_HUB_URL=https://mblode-computer.fly.dev
# HUB_URL=http://127.0.0.1:8787

# Optional, login buttons appear only when both id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# PostHog product analytics. Tokens live on Vercel; never commit them.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
