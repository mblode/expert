# Better Auth — https://better-auth.com
BETTER_AUTH_SECRET=              # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Turso (libSQL) — https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Email delivery for one-time codes (optional in dev: the code logs to the
# server console when RESEND_API_KEY is unset).
RESEND_API_KEY=
AUTH_EMAIL_FROM=Computer <hello@send.blode.co>

# Hub the signed-in server Pairs with. COMPUTER_SETUP_CODE is never NEXT_PUBLIC.
# On Vercel this is the Fly computer. Leave unset only for same-origin local hub.
COMPUTER_SETUP_CODE=
NEXT_PUBLIC_HUB_URL=https://mblode-computer.fly.dev
COMPUTER_HUB_URL=https://mblode-computer.fly.dev

# Optional — login buttons appear only when both id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
