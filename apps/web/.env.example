# Better Auth, https://better-auth.com
BETTER_AUTH_SECRET=              # generate with: openssl rand -base64 32 (required in production)
BETTER_AUTH_URL=http://localhost:3000
# Production: https://hello.expert

# Who may sign in. A signed-in user is bound to a computer, so leave this
# unset only for a private deployment. Comma-separated, case-insensitive.
AUTH_ALLOWED_EMAILS=

# Turso (libSQL), https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Email delivery for one-time codes. Required in production; in dev the code
# logs to the server console when unset.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Expert <hello@send.blode.co>

# Each computer has its own Pair setup code (the matching Fly secret).
# COMPUTER_SETUP_CODE is never NEXT_PUBLIC. NEXT_PUBLIC_HUB_URL is Blode's
# fallback only; reconnect/pair uses the computer the session is bound to.
COMPUTER_SETUP_CODE=
COMPUTER_SETUP_CODE_VCMC=
NEXT_PUBLIC_HUB_URL=https://mblode-computer.fly.dev
COMPUTER_HUB_URL=https://mblode-computer.fly.dev
# COMPUTER_HUB_URL_BLODE=https://mblode-computer.fly.dev
# COMPUTER_HUB_URL_MATT=https://mblode-computer.fly.dev
# COMPUTER_HUB_URL_VIBEY=https://vcmc-computer.fly.dev
# COMPUTER_HUB_URL_VCMC=https://vcmc-computer.fly.dev
# COMPUTER_OPERATOR_EMAILS=m@blode.co
# COMPUTER_BINDINGS=m@blode.co:blode
# HUB_URL=http://127.0.0.1:8787

# The shared secret Eve's mint client sends on POST /api/invite, as
# x-invite-secret or Bearer. Either name works. It is not an account, so it
# carries no computer binding: INVITE_MINT_COMPUTER_ID is the one computer it
# may mint links for, defaulting to the WhatsApp group's. Operators are scoped
# by COMPUTER_OPERATOR_EMAILS instead and are not limited to it.
EXPERT_INVITE_SECRET=
# INVITE_MINT_SECRET=
# INVITE_MINT_COMPUTER_ID=vibey

# Optional, login buttons appear only when both id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# PostHog product analytics. Tokens live on Vercel; never commit them.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
