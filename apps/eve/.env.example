# Eve's body: the computer's hub. Default assumes Eve runs on the box itself.
COMPUTER_URL=http://127.0.0.1:8787
# Bot token = Eve's identity + her screen. Mint it once:
#   npm run bot -- new eve        (from the repo root, hub running)
COMPUTER_BOT_TOKEN=

# Eve's brain: Vercel AI Gateway by default (or link a Vercel project).
AI_GATEWAY_API_KEY=

# Optional: an MCP server running on this machine, e.g. http://127.0.0.1:8788/mcp
# Unset means no local connection is registered. Streamable HTTP or SSE only —
# eve has no stdio transport, so front a stdio server with an HTTP bridge.
COMPUTER_MCP_URL=
