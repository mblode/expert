#!/bin/bash
# stop-window N — release window index N: kill its Xvfb + x11vnc and
# clear its entry in /workspace/.window-assignments.json.
set -euo pipefail

N="${1:?usage: stop-window N}"
if ! [[ "$N" =~ ^[0-9]+$ ]] || (( N < 1 || N > 8 )); then
  echo "window index must be 1..8" >&2
  exit 2
fi

export HOME="${HOME:-/home/box}"
ASSIGN="/workspace/.window-assignments.json"
LOCK="/workspace/.window-assignments.lock"
TOKEN_DIR="${COMPUTER_VNC_TOKEN_DIR:-/tmp/computer-vnc}"

# Kill this window's X server and its view-only x11vnc; openbox and
# chromium exit with their display.
pkill -f "Xvfb :$N " >/dev/null 2>&1 || true
pkill -f "x11vnc -display :$N " >/dev/null 2>&1 || true
rm -f "/tmp/.X11-unix/X$N" "/tmp/.X$N-lock" "$TOKEN_DIR/$N" >/dev/null 2>&1 || true

exec 9>"$LOCK"
flock 9
python3 - "$ASSIGN" "$N" <<'PY'
import json, sys
path, n = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
except (ValueError, FileNotFoundError):
    data = {}
data.pop(n, None)
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
PY

echo "window $N stopped"
