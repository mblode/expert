#!/bin/bash
# start-window N [owner-hash] [bot-id]
#
# Claim window index N (X display :N, RFB port 5900+N) for a Bot.
# Assignments live in $HOME/.window-assignments.json with sha256 owner
# hashes, never raw tokens. Re-claim by the same owner is idempotent;
# a different owner gets exit 9. Bots are not security boundaries —
# same box user, shared /workspace.
set -euo pipefail

N="${1:?usage: start-window N [owner-hash] [bot-id] [--force]}"
OWNER="${2:-}"
BOT_ID="${3:-}"
# --force takes a window whose claim belongs to an owner we no longer know.
# The hub's roster is authoritative at boot; the box's file is a cache.
FORCE=0
[[ "${4:-}" == "--force" ]] && FORCE=1
if ! [[ "$N" =~ ^[0-9]+$ ]] || (( N < 1 || N > 8 )); then
  echo "window index must be 1..8" >&2
  exit 2
fi

export HOME="${HOME:-/home/box}"
DISPLAY_NAME=":$N"
RFB_PORT=$((5900 + N))
# On the workspace volume: recreating the container must not cost a Bot
# its screen, so the claim roster outlives the container filesystem.
ASSIGN="/workspace/.window-assignments.json"
LOCK="/workspace/.window-assignments.lock"

mkdir -p "$HOME/.vnc" /workspace
touch "$ASSIGN"

claim() {
  python3 - "$ASSIGN" "$N" "$OWNER" "$BOT_ID" "$FORCE" <<'PY'
import json, sys, time
path, n, owner, bot_id, force = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5] == "1"
try:
    with open(path) as f:
        data = json.load(f)
except (ValueError, FileNotFoundError):
    data = {}
entry = data.get(n)
if not force and entry and owner and entry.get("owner") and entry["owner"] != owner:
    print(f"window {n} claimed by another owner", file=sys.stderr)
    sys.exit(9)
data[n] = {"owner": owner, "bot_id": bot_id, "claimed_at": int(time.time())}
with open(path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
PY
}

# Claim under an exclusive lock, in a subshell so the lock's fd dies with
# it. A background X server started while fd 9 is open inherits it and
# holds the flock for its whole life, deadlocking every later call.
( exec 9>"$LOCK"; flock 9; claim ) || exit $?

# Already serving this display? Idempotent success — but only when the
# server is really alive. A restart leaves the socket file behind, and
# trusting it would leave the box with a dead desktop that looks up.
if [[ -e "/tmp/.X11-unix/X$N" ]]; then
  if DISPLAY="$DISPLAY_NAME" xdpyinfo >/dev/null 2>&1; then
    echo "window $N up on $DISPLAY_NAME rfb $RFB_PORT"
    exit 0
  fi
  echo "window $N: clearing a stale socket from a previous run" >&2
  rm -f "/tmp/.X11-unix/X$N" "/tmp/.X${N}-lock"
fi

# X server for this window. Xvnc directly, not the `vncserver` wrapper:
# the wrapper refuses passwordless mode and wants a tigervncpasswd binary
# Debian does not ship.
#
# AcceptKeyEvents/AcceptPointerEvents=0 make the RFB channel pixels-out
# only: a viewer cannot inject input even if it tries. All input arrives
# as XTEST from the hub, which is what enforces the seat.
Xvnc "$DISPLAY_NAME" \
  -geometry 1280x800 \
  -depth 24 \
  -rfbport "$RFB_PORT" \
  -SecurityTypes None \
  -AlwaysShared \
  -AcceptKeyEvents=0 \
  -AcceptPointerEvents=0 \
  -desktop "computer:$N" \
  >"/tmp/xvnc-$N.log" 2>&1 &

# Wait for the display before anything tries to draw on it.
for _ in $(seq 1 50); do
  [[ -e "/tmp/.X11-unix/X$N" ]] && break
  sleep 0.1
done

DISPLAY="$DISPLAY_NAME" openbox >"/tmp/openbox-$N.log" 2>&1 &
sleep 0.4

# Chromium per window. Window 1 keeps the default profile dir (volume mount).
# --no-sandbox: the container is the sandbox; Chromium's own needs
# privileges a desk container should not have.
# The occlusion/backgrounding flags are load-bearing: with no VNC viewer
# attached Chromium decides the window is not visible and stops painting, so
# the agent's screenshot keeps returning a frozen frame — it navigates, sees
# the old page, and retries forever.
CHROMIUM="$(command -v chromium || command -v chromium-browser || true)"
if [[ -n "$CHROMIUM" ]]; then
  PROFILE="$HOME/.config/chromium"
  if (( N != 1 )); then PROFILE="$HOME/.config/chromium-$N"; fi
  mkdir -p "$PROFILE"
  DISPLAY="$DISPLAY_NAME" "$CHROMIUM" \
    --no-first-run \
    --no-default-browser-check \
    --no-sandbox \
    --test-type \
    --disable-features=CalculateNativeWinOcclusion \
    --disable-backgrounding-occluded-windows \
    --disable-renderer-backgrounding \
    --disable-background-timer-throttling \
    --hide-crash-restore-bubble \
    --disable-infobars \
    --disable-sync \
    --disable-gpu \
    --user-data-dir="$PROFILE" \
    --window-size=1280,800 \
    --window-position=0,0 \
    about:blank >"/tmp/chromium-$N.log" 2>&1 &
fi

echo "window $N up on $DISPLAY_NAME rfb $RFB_PORT"
